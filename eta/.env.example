# Database the worker drains.
DATABASE_URL=postgres://user:pass@localhost:5432/azb

# ETA credentials, issued when the company registers its ERP on the
# authority's portal. These are per-taxpayer, not per-vendor.
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=

# Environment and endpoints. Confirm the exact hosts against the ETA SDK
# documentation before pointing this at anything real.
ETA_ENVIRONMENT=preprod
ETA_IDENTITY_URL=
ETA_API_URL=

# Signing. 'dev' produces structurally-shaped placeholder seals and is refused
# when ETA_ENVIRONMENT=production. Production needs an HSM or an
# ETA-approved cloud signing service.
ETA_SIGNER=dev

WORKER_ID=
WORKER_IDLE_MS=5000
